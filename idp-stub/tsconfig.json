{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    // Rooted a level up for the same reason registry-stub's is: Canon's own
    // auth tests compile this stub in-process and boot it there, so the flow
    // under test is the real provider rather than a mock of one. Output
    // therefore lands in dist/idp-stub/…
    "rootDir": "..",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
